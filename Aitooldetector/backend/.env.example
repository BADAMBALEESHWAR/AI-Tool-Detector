
# Database
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/ai_monitor"

# JWT Secrets (replace with strong random values locally)
JWT_SECRET="replace_with_a_random_secret"
JWT_REFRESH_SECRET="replace_with_another_random_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Admin JWT
ADMIN_JWT_SECRET="replace_with_a_third_random_secret"
ADMIN_JWT_EXPIRES_IN="8h"
