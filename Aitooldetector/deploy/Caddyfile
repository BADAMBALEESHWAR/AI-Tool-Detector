# Each site address is a full URL from the server's .env, e.g.
#   STUDENT_URL=https://portal.example.edu  ADMIN_URL=https://admin.example.edu  API_URL=https://api.example.edu
# Caddy obtains and renews HTTPS certificates automatically for https:// addresses
# (DNS must point at the EC2 instance and ports 80/443 must be open).
# WebSocket upgrades for Socket.IO are proxied automatically.

{$STUDENT_URL} {
	encode gzip
	reverse_proxy student:80
}

{$ADMIN_URL} {
	encode gzip
	reverse_proxy admin:80
}

{$API_URL} {
	reverse_proxy backend:3001
}
