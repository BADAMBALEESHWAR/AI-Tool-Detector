# Environment for docker-compose.yml (local) and docker-compose.prod.yml (AWS).
# Copy to .env and fill in. Never commit the real .env.
# Generate secrets with:  openssl rand -hex 32

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_monitor
# Using Amazon RDS instead of the bundled Postgres container? Set the full URL:
# DATABASE_URL=postgresql://user:pass@your-rds-endpoint:5432/ai_monitor

# ── Auth secrets (all three must be different) ──────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=

# ── Public URLs (no trailing slash) ─────────────────────────────────────────
# Local defaults are used when these are empty. In production they are the
# HTTPS addresses Caddy serves and the origins the API allows through CORS.
STUDENT_URL=
ADMIN_URL=
API_URL=

# ── Production only (docker-compose.prod.yml) ───────────────────────────────
# <aws-account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=

# Set to true for the FIRST start only: loads the built-in AI tool list,
# default settings and the default admin (admin@institution.edu / Admin@123 —
# change that password immediately). Leaving it on resets settings each restart.
RUN_SEED=false
