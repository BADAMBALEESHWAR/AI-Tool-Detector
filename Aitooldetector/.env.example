# Environment for the local Docker stack (docker-compose.yml).
# Copy to .env and fill in. Never commit the real .env.
# The production server has its own .env in /opt/ai-monitor (see DEPLOYMENT.md).
# Generate secrets with:  openssl rand -hex 32

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_monitor

# ── Auth secrets (all three must be different) ──────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=

# ── Public URLs (no trailing slash) ─────────────────────────────────────────
# Leave empty for the localhost defaults.
STUDENT_URL=
ADMIN_URL=
API_URL=

# Set to true for the FIRST start only: loads the built-in AI tool list,
# default settings and the default admin (admin@institution.edu / Admin@123 —
# change that password immediately). Leaving it on resets settings each restart.
RUN_SEED=false
